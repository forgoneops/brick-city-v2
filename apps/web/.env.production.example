# Copy to .env.production (or set these in your host's dashboard — Vercel/
# Cloudflare Pages env var UI is the more common path for a static frontend
# deploy) and fill in real values. See docs/deploy.md.

# Leave empty (the default) if frontend and backend share an origin behind
# a reverse proxy — the recommended topology, see docs/DECISIONS.md
# ("Deploy prep") for why. Only set this for a genuinely cross-origin split
# (e.g. frontend on Vercel, backend on a separate VPS domain).
VITE_API_BASE_URL=

# Cloudflare Turnstile site key (safe to expose — it's public by design,
# unlike TURNSTILE_SECRET_KEY on the server). Leave empty to keep the
# registration bot-check widget disabled.
VITE_TURNSTILE_SITE_KEY=
