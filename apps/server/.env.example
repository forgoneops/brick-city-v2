DATABASE_URL=mysql://root:brickcity@localhost:3306/brickcity
JWT_SECRET=change-me-in-production
PORT=3001
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15
# Cloudflare Turnstile — leave empty to disable (dev default). See
# apps/server/src/lib/turnstile.ts.
TURNSTILE_SECRET_KEY=

# Stripe + Przelewy24 real adapters (modules/subscriptions/providers.ts) —
# getProvider() falls back to MockPaymentProvider unless every var for that
# provider is set. See docs/deploy.md ("Real payment providers").
# Unset in this environment — no Stripe account configured yet.
STRIPE_SECRET_KEY=
# Unset in this environment — from the Stripe Dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Unset in this environment — no Przelewy24 merchant account configured yet.
P24_MERCHANT_ID=
# Unset in this environment — often identical to P24_MERCHANT_ID.
P24_POS_ID=
# Unset in this environment — CRC key from the P24 merchant panel.
P24_CRC=
# Unset in this environment — API key ("key for reports") from the P24 panel.
P24_API_KEY=
