# Production environment template. Copy to .env on the deploy target and
# fill in real values — never commit an actual .env file (it's gitignored).
# See docs/deploy.md for the full deploy walkthrough.

# Managed MySQL connection string (e.g. PlanetScale / RDS / DO Managed DB).
# Require TLS in production — most managed providers need ?ssl={"rejectUnauthorized":true}
# or an equivalent sslmode param; check your provider's docs for the exact string.
DATABASE_URL=mysql://user:password@your-managed-mysql-host:3306/brickcity

# Generate with: openssl rand -base64 48
JWT_SECRET=

PORT=3001

# 'local' writes to UPLOADS_DIR on the server's own disk — fine for a single
# VPS, but see docs/DECISIONS.md ("Deploy prep") for the cross-origin/
# multi-instance caveat this implies. An S3-compatible driver can be added
# behind the same StorageDriver interface (apps/server/src/lib/storage.ts)
# without touching any call sites, when that becomes necessary.
STORAGE_DRIVER=local
UPLOADS_DIR=/var/lib/brickcity/uploads
MAX_UPLOAD_MB=15

# Cloudflare Turnstile (dashboard.cloudflare.com -> Turnstile) — leave empty
# to keep registration bot-check disabled (not recommended in production).
TURNSTILE_SECRET_KEY=

# Stripe + Przelewy24 adapters are real (modules/subscriptions/providers.ts)
# but getProvider() falls back to MockPaymentProvider unless every var for
# that provider below is set — see docs/deploy.md ("Real payment providers")
# for the full switch-over procedure, including flipping the admin on/off
# switch, which stays off independently of these being set.
# Unset in this environment — no Stripe account configured yet.
STRIPE_SECRET_KEY=
# Unset in this environment — from the Stripe Dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Unset in this environment — no Przelewy24 merchant account configured yet.
P24_MERCHANT_ID=
# Unset in this environment — often identical to P24_MERCHANT_ID.
P24_POS_ID=
# Unset in this environment — CRC key from the P24 merchant panel.
P24_CRC=
# Unset in this environment — API key ("key for reports") from the P24 panel.
P24_API_KEY=
# PayPal has no real adapter — it stays MockPaymentProvider permanently by
# design (see docs/DECISIONS.md), so there's no env var for it here.
