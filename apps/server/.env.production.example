# Production environment template. Copy to .env on the deploy target and
# fill in real values — never commit an actual .env file (it's gitignored).
# See docs/deploy.md for the full deploy walkthrough.

# Managed MySQL connection string (e.g. PlanetScale / RDS / DO Managed DB).
# Require TLS in production — most managed providers need ?ssl={"rejectUnauthorized":true}
# or an equivalent sslmode param; check your provider's docs for the exact string.
DATABASE_URL=mysql://user:password@your-managed-mysql-host:3306/brickcity

# Generate with: openssl rand -base64 48
JWT_SECRET=

PORT=3001

# 'local' writes to UPLOADS_DIR on the server's own disk — fine for a single
# VPS, but see docs/DECISIONS.md ("Deploy prep") for the cross-origin/
# multi-instance caveat this implies. An S3-compatible driver can be added
# behind the same StorageDriver interface (apps/server/src/lib/storage.ts)
# without touching any call sites, when that becomes necessary.
STORAGE_DRIVER=local
UPLOADS_DIR=/var/lib/brickcity/uploads
MAX_UPLOAD_MB=15

# Cloudflare Turnstile (dashboard.cloudflare.com -> Turnstile) — leave empty
# to keep registration bot-check disabled (not recommended in production).
TURNSTILE_SECRET_KEY=

# --- Not yet read by any code — documented here so they land in the right
# place once modules/subscriptions/providers.ts grows a real adapter beyond
# MockPaymentProvider (see docs/DECISIONS.md, "Subscriptions + wallet").
# Do NOT set these until that real-provider work exists; a key sitting in
# an unused env var is still a live credential to rotate/leak.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PRZELEWY24_MERCHANT_ID=
# PRZELEWY24_API_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
